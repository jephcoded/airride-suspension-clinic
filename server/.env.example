# --- Core ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
DATABASE_URL=postgresql://airride:airride@localhost:5433/airride?schema=public
DATABASE_URL_UNPOOLED=postgresql://airride:airride@localhost:5433/airride?schema=public
JWT_SECRET=change-me-to-a-long-random-string

# --- Business ---
WORKSHOP_NAME=Airride Suspension Clinic
WORKSHOP_ADDRESS=Workshop address, Lagos, Nigeria
WORKSHOP_PHONE=0703 306 0775
DEFAULT_WARRANTY_MONTHS=6

# --- Payments (Paystack). Leave empty to use mock payments in development ---
PAYSTACK_SECRET_KEY=

# --- Email (SMTP). Leave empty to log emails to console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Airride Suspension Clinic <no-reply@airride.ng>"

# --- SMS (Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=Airride
TERMII_BASE_URL=

# --- Or: SMS from the workshop's Android phone (free app "SMS Gateway for Android", sms-gate.app). Overrides Termii when set. ---
PHONE_SMS_USER=
PHONE_SMS_PASS=
PHONE_SMS_URL=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=repair_update
WHATSAPP_TEMPLATE_LANG=en

# --- File storage: S3-compatible bucket (Cloudflare R2, AWS S3, DO Spaces). Needed when running >1 server ---
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Database backups (spec 22). pg_dump must be installed; copies go to the bucket too when S3_BUCKET is set ---
BACKUP_DAILY=true
BACKUP_HOUR=2
BACKUP_KEEP=14
# Local Docker only: run pg_dump inside the database container
PG_DUMP_DOCKER=

# --- First admin account for production (npm run db:seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Number of proxies in front of the app (1 for most hosts). Leave empty in development.
TRUST_PROXY=

# --- Web push (phone notifications). Generate with: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@business.ng
